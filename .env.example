# Copy to .env.local and fill in. The two Resend vars are read only at runtime,
# by the contact form's Server Action, so `npm run build` works without them.
# SITE_URL is the exception: it is read during the build.

# The site's canonical origin. Read at BUILD time by the metadata, sitemap and
# robots routes, so it has to be set in the build environment and not only the
# runtime one, or the deployed site advertises the wrong URLs.
#
# Optional. Unset or blank, it falls back to RENDER_EXTERNAL_URL, which Render
# sets to the service's own URL at build time, and then to http://localhost:3000.
# Set it explicitly only for a custom domain; it outranks both. A missing scheme
# is filled in as https:// and a trailing slash is stripped, so example.com and
# https://example.com/ end up the same.
SITE_URL=

# Resend API credential. Server-only, never prefix with NEXT_PUBLIC_.
# A "Sending access" key is enough; the app only calls emails.send.
RESEND_API_KEY=

# Where contact form submissions are delivered. Until a domain is verified in
# Resend, the sender is onboarding@resend.dev, and that sender can only deliver
# to the address that owns the Resend account. So this has to be that address.
CONTACT_EMAIL_TO=
